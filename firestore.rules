rules_version = '2';
// Each signed-in person can read and write only their own journal.
// Nobody else (other users, anyone signed out) can read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
