{
  "name": "akouo-ios",
  "private": true,
  "version": "1.0.0",
  "description": "Akou\u014d for iPhone: wraps the web app in the parent folder with Capacitor.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "sync": "node build.mjs && npx cap sync ios",
    "assets": "npx capacitor-assets generate --ios --iconBackgroundColor '#5D6B3F' --iconBackgroundColorDark '#5D6B3F' --splashBackgroundColor '#F5F2EA' --splashBackgroundColorDark '#1F2218'"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.0",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@fontsource/alegreya": "5.2.8",
    "@fontsource/alegreya-sans": "5.2.8",
    "@fontsource/alegreya-sans-sc": "5.2.7",
    "esbuild": "0.27.7",
    "firebase": "10.12.2"
  }
}
